{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/dist/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "win-x64-debug",
      "displayName": "Windows x64 Debug (MSVC)",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "EXTRACT_TARGET_ARCHITECTURE": "x64"
      }
    },
    {
      "name": "win-x64-release",
      "displayName": "Windows x64 Release (MSVC)",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "EXTRACT_TARGET_ARCHITECTURE": "x64"
      }
    },
    {
      "name": "win-x86-debug",
      "displayName": "Windows x86 Debug (MSVC)",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "EXTRACT_TARGET_ARCHITECTURE": "x86",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-x86-release",
      "displayName": "Windows x86 Release (MSVC)",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "EXTRACT_TARGET_ARCHITECTURE": "x86",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-arm64-debug",
      "displayName": "Windows arm64 Debug (MSVC)",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "EXTRACT_TARGET_ARCHITECTURE": "arm64",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-arm64-release",
      "displayName": "Windows arm64 Release (MSVC)",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "EXTRACT_TARGET_ARCHITECTURE": "arm64",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-x64-debug",
      "configurePreset": "win-x64-debug"
    },
    {
      "name": "win-x64-release",
      "configurePreset": "win-x64-release"
    },
    {
      "name": "win-x86-debug",
      "configurePreset": "win-x86-debug"
    },
    {
      "name": "win-x86-release",
      "configurePreset": "win-x86-release"
    },
    {
      "name": "win-arm64-debug",
      "configurePreset": "win-arm64-debug"
    },
    {
      "name": "win-arm64-release",
      "configurePreset": "win-arm64-release"
    }
  ]
}
